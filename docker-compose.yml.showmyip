services:

  showmyip:
    build: .
    image: hackinglab/showmyip:latest
    labels:
      - "traefik.enable=true"
      # HTTP Routers
      - "traefik.http.routers.showmyip.entrypoints=websecure"
      - "traefik.http.routers.showmyip.rule=Host(`showmyip.idocker.hacking-lab.com`)"
      # HTTP Services
      - "traefik.http.routers.showmyip.service=showmyip"
      - "traefik.http.services.showmyip.loadBalancer.server.port=8080"
    restart: always
    volumes:
      - ./logs:/opt/logs
    networks:
      transit:

networks:
  transit:
    external: true


